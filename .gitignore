__pycache__/
*.pyc
*.pyo
.venv/
venv/
.env
data/*.db
data/*.db-journal
# Generated article artifacts (anywhere under content/journals/<slug>/...)
content/**/article-raw.md
content/**/article.html
content/**/article.pdf
content/**/article.typ
# Derived sources and galleys for an article whose teacher material is
# split out; article.md stays the one canonical copy.
content/**/.chapter.md
content/**/.teacher.md
content/**/.teacher.typ
content/**/teacher-resources.pdf
content/**/teacher-resources.html
content/**/article.epub
content/**/conversion.log
content/**/.versions/
content/**/source.docx
content/**/source.pdf
content/**/articles/*/assets/
content/**/_unfiled/*/assets/
# Per-article copy of the journal stylesheet (the canonical template/article.css
# is committed; copies under articles/ are regenerated each render).
content/**/articles/*/article.css
content/**/_unfiled/*/article.css
# Issue-level artifacts
content/**/issue.pdf
content/**/issue-toc.json
content/**/_cover.pdf
content/**/_cover.typ
content/**/_front_matter.pdf
content/**/_front_matter.typ
# Hold-out article directories (uploads not yet committed; canonical article.md will be committed when ready)
content/**/_unfiled/
# Per-article PDF preview rasters
content/**/preview/
# The per-journal template bundle holds source files whose names match the
# generated artifacts above. A bundle's article.typ is the Typst template, not
# a render intermediate, and it has to stay in git. The LiCS copy survives only
# because it was tracked before that rule existed; without this negation a
# journal scaffolded by new_journal.py silently loses its Typst template.
!content/journals/*/template/article.typ
_dropbox/
*.log
.DS_Store
.vscode/
.idea/
